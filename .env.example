# Azure SQL — hkrl8282.database.windows.net
# SQLAlchemy format (for pipeline + API)
DATABASE_URL=mssql+pyodbc://YOUR_USER:YOUR_PASSWORD@hkrl8282.database.windows.net/YOUR_DATABASE?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no

# SEC EDGAR identity (required by SEC fair access policy)
SEC_IDENTITY=your-email@company.com

# Pipeline settings
DEFAULT_QUARTERS_BACK=8
BENCHMARK_TICKER=SPY
