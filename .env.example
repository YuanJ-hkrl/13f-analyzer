# Azure SQL (SQLAlchemy format)
# mssql+pyodbc://USER:PASSWORD@SERVER.database.windows.net/DATABASE?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no
DATABASE_URL=

# SEC EDGAR identity (required by SEC fair access policy)
SEC_IDENTITY=your-email@company.com

# Pipeline settings
DEFAULT_QUARTERS_BACK=8
BENCHMARK_TICKER=SPY
