# Set to "true" to use mock provider + user data (no real API keys needed)
DEMO_MODE=true

# --- OpenAI ---
# Admin key required for organization costs API (platform.openai.com → Organization → Admin keys)
OPENAI_ADMIN_KEY=
# Optional monthly budget in USD so remaining = budget − period spend
OPENAI_MONTHLY_BUDGET=100

# --- xAI / Grok ---
# Management key (console.x.ai → Settings → Management Keys), not the inference key
XAI_MANAGEMENT_KEY=
# Optional; auto-resolved from the management key when omitted
XAI_TEAM_ID=

# --- DeepSeek ---
DEEPSEEK_API_KEY=

# --- Qwen / DashScope (Alibaba Cloud Model Studio) ---
DASHSCOPE_API_KEY=
# International endpoint by default; use https://dashscope.aliyuncs.com/api/v1 for China
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1

# --- Supabase (user count + new registration alerts) ---
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Table to count rows from (default: profiles). Must be readable with the service role key.
SUPABASE_USERS_TABLE=profiles

# Alert when remaining balance (USD) drops below this
LOW_BALANCE_THRESHOLD=10

# How often the dashboard polls (ms)
POLL_INTERVAL_MS=30000
